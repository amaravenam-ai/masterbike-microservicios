FROM maven:3.9.12-eclipse-temurin-21 AS build
WORKDIR /work
COPY pom.xml .
COPY src src
RUN --mount=type=cache,id=portfolio-masterbike-maven,target=/root/.m2,sharing=locked mvn -B -ntp -DskipTests package
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /work/target/*.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]
